# Copy to .env (ignored). All values here are synthetic or deliberately incomplete.
# Load with: dotenv -f .env run --no-override -- <command>
# No Azure password, API key, webhook secret or storage key is needed.
# Cloud commands use your signed-in Azure CLI identity or workload/managed identity.

# Deployment inputs: replace before planning. Terraform reads TF_VAR_* automatically.
TF_VAR_tenant_id=00000000-0000-0000-0000-000000000000
TF_VAR_subscription_id=00000000-0000-0000-0000-000000000000
TF_VAR_tags='{"owner":"REPLACE-owner","cost-center":"REPLACE-cost-center"}'
BATCH_OWNER=REPLACE-owner
BATCH_COST_CENTER=REPLACE-cost-center
# Put approved model/version/capacity in an ignored terraform.tfvars copied from the example.
# Put backend coordinates in an ignored backend.hcl copied from the example.

# Local application profile only. Do not copy emulator settings to Azure.
BATCH_ENVIRONMENT=local
BATCH_RESOURCES_JSON='[{"key":"eus2","endpoint":"http://127.0.0.1:8080/","region":"eastus2","deployments":["example-batch-deployment"]}]'
BATCH_PROVIDER_BACKEND=emulator
BATCH_FOUNDRY_AUTH=emulator
BATCH_STORAGE_BACKEND=memory
BATCH_SECRETS_BACKEND=memory
BATCH_CLIENT_VAULT_BACKEND=emulator
BATCH_DOWNSTREAM_MODE=demo
